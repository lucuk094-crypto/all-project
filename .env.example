# ============================================================
#  Salin file ini menjadi .env.local lalu isi nilainya.
#  JANGAN commit .env.local (sudah diabaikan .gitignore).
# ============================================================

# ---------- Supabase (AMAN dibagikan ke browser) ----------
# Ambil dari Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------- Supabase (RAHASIA — server saja) ----------
# Service role key MELEWATI RLS. Jangan pernah diberi awalan NEXT_PUBLIC_,
# jangan pernah di-import dari Client Component.
# Kalau kosong, panel admin akan menampilkan pesan error yang jelas.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- Admin ----------
# Kata sandi panel admin. TIDAK lagi memakai awalan NEXT_PUBLIC_,
# sehingga nilainya tidak pernah ikut ke dalam bundle browser.
ADMIN_PASSWORD=ganti-dengan-kata-sandi-yang-kuat

# ---------- Sesi ----------
# Kunci untuk menandatangani cookie sesi (HMAC-SHA256).
# Bisa diisi string acak panjang, misalnya hasil dari:  openssl rand -hex 32
# Jika kosong, akan dipakai ADMIN_PASSWORD sebagai fallback.
SESSION_SECRET=isi-dengan-string-acak-32-karakter-atau-lebih
